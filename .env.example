# Contact form (src/app/api/contact/route.ts). Copy to .env.local or set it in Vercel.
RESEND_API_KEY=
CONTACT_TO=
# Sender verified in Resend; without a verified domain, use Resend's testing sender.
CONTACT_FROM="Fullkod web <web@fullkod.com>"

# Search engine verification (optional). Value of the meta tag given by Search Console / Bing Webmaster.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
